                <div class="form-header-title">
                    <h1>Inshuti Mu Buzima / PIH Rwanda</h1>
                    <h2>Oncology Program - Breast Ultrasound Report</h2>
                </div>
            </div>
            <div class="form-header-right">
                <div class="form-header-badge">Programme d'oncologie</div>
            </div>
        </div>
    </div>

    <!-- ===== PATIENT INFORMATION ===== -->
    <div class="patient-info-bar">
        <div class="patient-info-item">
            <span class="patient-info-label">IMB ID</span>
            <span class="patient-info-value">
                <lookup class="value" expression="patientIdentifiers.get(&quot;IMB ID&quot;)" />
                <lookup class="value" expression="patientIdentifiers.get(&quot;IMB Primary Care Registration ID&quot;)" />
            </span>
        </div>
        <div class="patient-info-item">
            <span class="patient-info-label">Last Name / Nom</span>
            <span class="patient-info-value">
                <lookup class="value" expression="patient.personName.familyName" />
            </span>
        </div>
        <div class="patient-info-item">
            <span class="patient-info-label">First Name / Prénom</span>
            <span class="patient-info-value">
                <lookup class="value" expression="patient.personName.givenName" />
            </span>
        </div>
    </div>

    <!-- ===== ENCOUNTER INFORMATION ===== -->
    <div class="encounter-info-bar">
        <div class="patient-info-item">
            <span class="patient-info-label">Encounter Date</span>
            <span class="form-field">
                <encounterDate id="encounterDate" default="today" />
            </span>
        </div>
        <div class="patient-info-item">
            <span class="patient-info-label">Clinic / Clinique</span>
            <span class="form-field">
                <encounterLocation id="encounterLocation" default="Butaro Hospital" />
            </span>
        </div>
        <div class="patient-info-item">
            <span class="patient-info-label">Provider</span>
            <span class="form-field">
                <encounterProvider id="encounterProvider" role="Oncology Provider" />
            </span>
        </div>
    </div>

    <!-- ===== PATIENT HISTORY AND EXAM ===== -->
    <div class="section-card">
        <div class="section-header">
            <span>📋</span>
            Patient History and Exam
        </div>
        <div class="section-content">
            <!-- Indication for Ultrasound -->
            <div class="form-row">
                <label class="form-label">Indication for Ultrasound <span class="form-sublabel">(check all that apply)</span></label>
                <div class="checkbox-group">
                    <span class="checkbox-item">
                        <obs conceptId="$@Indication_for_ultrasound@" answerConceptId="$@Self_palpated_lump@" answerLabel="Self palpated lump" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Indication_for_ultrasound@" answerConceptId="$@Focal_Pain@" answerLabel="Focal pain" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Indication_for_ultrasound@" answerConceptId="$@Doctor/Nurse_palpated_lump@" answerLabel="Doctor/Nurse palpated lump" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Indication_for_ultrasound@" answerConceptId="$@Follow-up_of_incidental_mass@" answerLabel="Follow-up of incidental mass" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Indication_for_ultrasound@" answerConceptId="$@OTHER_NON-CODED@" answerLabel="Other" style="checkbox"/>
                        <obs conceptId="$@Other_indication_of_ultrasound@" size="30"/>
                    </span>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Patient Status -->
            <div class="two-column">
                <div class="form-row">
                    <label class="form-label">Is the patient pregnant?</label>
                    <div class="radio-group">
                        <obs conceptId="$@Patient_Pregnant(coded)@" answerConceptIds="$@YES@,$@NO@" answerLabels="Yes,No" style="radio"/>
                    </div>
                </div>
                <div class="form-row">
                    <label class="form-label">Is the patient lactating?</label>
                    <div class="radio-group">
                        <obs conceptId="$@Patient_Lactating(coded)@" answerConceptIds="$@YES@,$@NO@" answerLabels="Yes,No" style="radio"/>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Breast Surgery History -->
            <div class="form-row">
                <label class="form-label">Breast Surgery History</label>
                <div class="radio-group">
                    <obs conceptId="$@Breast_Surgery_History_(coded)@" answerConceptIds="$@NONE@,$@YES@" answerLabels="None,History of breast surgery or biopsy" style="radio"/>
                </div>
                <div style="margin-top: 8px;">
                    <span class="inline-field">
                        <label>Please specify:</label>
                        <obs conceptId="$@Breast_Surgery_History(non-coded)@" size="40"/>
                    </span>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Side of Complaint -->
            <div class="form-row">
                <label class="form-label">Side of Complaint / Ultrasound</label>
                <div class="checkbox-group">
                    <span class="checkbox-item">
                        <obs conceptId="$@Side_of_complaint/ultrasound@" answerConceptId="$@Right_breast@" answerLabel="Right breast" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Side_of_complaint/ultrasound@" answerConceptId="$@Left_breast@" answerLabel="Left breast" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Side_of_complaint/ultrasound@" answerConceptId="$@Right_axilla@" answerLabel="Right axilla" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Side_of_complaint/ultrasound@" answerConceptId="$@Left_axilla@" answerLabel="Left axilla" style="checkbox"/>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ULTRASOUND FINDINGS ===== -->
    <div class="section-card">
        <div class="section-header">
            <span>🔬</span>
            Ultrasound Findings
        </div>
        <div class="section-content">
            <!-- Mass Visibility -->
            <div class="two-column">
                <div class="form-row">
                    <label class="form-label">Mass Visible?</label>
                    <div class="radio-group">
                        <obs conceptId="$@Mass_visible@" answerConceptIds="$@YES@,$@NO@" answerLabels="Yes,No" style="radio"/>
                    </div>
                </div>
                <div class="form-row">
                    <label class="form-label">If present, corresponds to palpable findings?</label>
                    <div class="radio-group">
                        <obs conceptId="$@mass_felt_also_seen_in_ultrasound@" answerConceptIds="$@YES@,$@NO@" answerLabels="Yes,No (mass not palpable)" style="radio"/>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Mass Location -->
            <div class="form-row">
                <label class="form-label">Mass Location</label>
                <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 8px;">
                    <span class="inline-field">
                        <label>Clock face:</label>
                        <obs conceptId="$@clock_face@" size="10"/>
                    </span>
                    <span class="inline-field">
                        <label>Distance from nipple center:</label>
                        <obs conceptId="$@location_of_mass_from_center_of_nipple@" size="6"/>
                        <span class="unit">cm</span>
                    </span>
                </div>
            </div>

            <!-- Depth -->
            <div class="form-row">
                <label class="form-label">Depth</label>
                <span class="inline-field">
                    <label>Surface of mass from skin surface:</label>
                    <obs conceptId="$@surface_of_mass_form_skin_surface@" size="6"/>
                    <span class="unit">mm</span>
                </span>
            </div>

            <div class="divider"></div>

            <!-- Dimensions -->
            <div class="form-row">
                <label class="form-label">Dimensions</label>
                <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 8px;">
                    <span class="inline-field">
                        <label>Long/Radial:</label>
                        <obs conceptId="$@Long/Radial@" size="6"/>
                        <span class="unit">cm</span>
                    </span>
                    <span class="inline-field">
                        <label>Transverse/Anti-radial:</label>
                        <obs conceptId="$@Transverse/Anti-radial@" size="6"/>
                        <span class="unit">cm</span>
                    </span>
                    <span class="inline-field">
                        <label>AP:</label>
                        <obs conceptId="$@Anterior-posterior@" size="6"/>
                        <span class="unit">cm</span>
                    </span>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Characteristics Grid -->
            <div class="findings-grid">
                <!-- Shape -->
                <div class="findings-card">
                    <div class="findings-card-title">Shape</div>
                    <div class="findings-card-options">
                        <span class="findings-option">
                            <obs conceptId="$@Shape_of_mass@" answerConceptId="$@Oval_or_round@" answerLabel="Oval or round" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Shape_of_mass@" answerConceptId="$@Lobular@" answerLabel="Lobular" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Shape_of_mass@" answerConceptId="$@irregular@" answerLabel="Irregular" style="checkbox"/>
                        </span>
                    </div>
                </div>

                <!-- Margins -->
                <div class="findings-card">
                    <div class="findings-card-title">Margins</div>
                    <div class="findings-card-options">
                        <span class="findings-option">
                            <obs conceptId="$@Margins@" answerConceptId="$@Circumscribed/Smooth@" answerLabel="Circumscribed/Smooth" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Margins@" answerConceptId="$@Indistinct@" answerLabel="Indistinct" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Margins@" answerConceptId="$@Microlobulated@" answerLabel="Microlobulated" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Margins@" answerConceptId="$@irregular@" answerLabel="Irregular" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Margins@" answerConceptId="$@Spiculated/Angular@" answerLabel="Spiculated/Angular" style="checkbox"/>
                        </span>
                    </div>
                </div>

                <!-- Internal Echo Texture -->
                <div class="findings-card">
                    <div class="findings-card-title">Internal Echo Texture</div>
                    <div class="findings-card-options">
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Anechoeic@" answerLabel="Anechoeic" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Hypoechoeic@" answerLabel="Hypoechoeic" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Isoechoic@" answerLabel="Isoechoic" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Hyperechoic@" answerLabel="Hyperechoic" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Homogeneous@" answerLabel="Homogeneous" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Internal_Echo_Texture@" answerConceptId="$@Heterogeneous@" answerLabel="Heterogeneous" style="checkbox"/>
                        </span>
                    </div>
                </div>

                <!-- Acoustic Transmission -->
                <div class="findings-card">
                    <div class="findings-card-title">Acoustic Transmission</div>
                    <div class="findings-card-options">
                        <span class="findings-option">
                            <obs conceptId="$@Acoustic_Transmissioin@" answerConceptId="$@Posterior_Enhancement@" answerLabel="Posterior Enhancement" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Acoustic_Transmissioin@" answerConceptId="$@Posterior_Shadowing@" answerLabel="Posterior Shadowing" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Acoustic_Transmissioin@" answerConceptId="$@NONE@" answerLabel="None" style="checkbox"/>
                        </span>
                    </div>
                </div>

                <!-- Orientation -->
                <div class="findings-card">
                    <div class="findings-card-title">Orientation</div>
                    <div class="findings-card-options">
                        <span class="findings-option">
                            <obs conceptId="$@Orientation@" answerConceptId="$@Parallel@" answerLabel="Parallel" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Orientation@" answerConceptId="$@Anti-parallel@" answerLabel="Anti-parallel" style="checkbox"/>
                        </span>
                        <span class="findings-option">
                            <obs conceptId="$@Orientation@" answerConceptId="$@Neither@" answerLabel="Neither" style="checkbox"/>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ASSESSMENT ===== -->
    <div class="section-card">
        <div class="section-header">
            <span>📊</span>
            Assessment
        </div>
        <div class="section-content">
            <!-- Negative Ultrasound -->
            <div class="assessment-group">
                <div class="assessment-main">
                    <obs id="AssessmentCheckboxRadio" conceptId="$@assessment(coded)@" answerConceptId="$@Negative_ultrasound@" answerLabel="Negative ultrasound - normal breast or axilla" style="checkbox"/>
                </div>
            </div>

            <!-- Breast Mass -->
            <div class="assessment-group">
                <div class="assessment-main">
                    <obs id="AssessmentCheckboxRadio" conceptId="$@assessment(coded)@" answerConceptId="$@Breast_mass@" answerLabel="Breast mass (choose one)" style="checkbox"/>
                </div>
                <div class="assessment-sub">
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Breast_mass@" answerConceptId="$@Normal_intramammary_lymph_node@" answerLabel="Normal intramammary lymph node" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Breast_mass@" answerConceptId="$@Simple_cyst@" answerLabel="Simple cyst" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Breast_mass@" answerConceptId="$@Probable_cyst@" answerLabel="Probable cyst" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Breast_mass@" answerConceptId="$@Complex_cystic/solid_mass@" answerLabel="Complex cystic/solid mass" style="checkbox"/>
                        <span style="margin-left: 12px;">If yes, possible abscess?</span>
                        <obs conceptId="$@ABSCESS@" answerConceptIds="$@YES@,$@NO@" answerLabels="Yes,No" style="radio"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Breast_mass@" answerConceptId="$@Solid_mass@" answerLabel="Solid mass" style="checkbox"/>
                        <span style="margin-left: 12px;">Suspicion for malignancy:</span>
                        <obs conceptId="$@Solid_mass@" answerConceptIds="$@low@,$@Intermediate@,$@High@" answerLabels="Low,Intermediate,High" style="radio"/>
                    </div>
                </div>
            </div>

            <!-- Axillary Mass -->
            <div class="assessment-group">
                <div class="assessment-main">
                    <obs id="AssessmentCheckboxRadio" conceptId="$@assessment(coded)@" answerConceptId="$@Axillary_mass@" answerLabel="Axillary mass" style="checkbox"/>
                </div>
                <div class="assessment-sub">
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Axillary_mass@" answerConceptId="$@Normal_lymph_node@" answerLabel="Normal lymph node" style="checkbox"/>
                        <obs conceptId="$@Axillary_mass@" answerConceptId="$@Heterotopic_tissue@" answerLabel="Heterotopic tissue" style="checkbox"/>
                        <obs conceptId="$@Axillary_mass@" answerConceptId="$@Skin_Lesion@" answerLabel="Skin lesion" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Axillary_mass@" answerConceptId="$@Abnormal_palpable_lymph_node@" answerLabel="Abnormal palpable lymph node" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <obs conceptId="$@Axillary_mass@" answerConceptId="$@Abnormal_non-palpable_lymph_node@" answerLabel="Abnormal non-palpable lymph node" style="checkbox"/>
                        <obs conceptId="$@Abnormal_non-palpable_lymph_node@" answerConceptId="$@Unilateral@" answerLabel="Unilateral" style="checkbox"/>
                        <obs conceptId="$@Abnormal_non-palpable_lymph_node@" answerConceptId="$@Bilateral@" answerLabel="Bilateral" style="checkbox"/>
                    </div>
                    <div class="assessment-sub-item">
                        <span class="inline-field">
                            <label>Maximum cortical thickness:</label>
                            <obs conceptId="$@Cortical_thickness@" size="6"/>
                            <span class="unit">mm</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Other -->
            <div class="assessment-group">
                <div class="assessment-main">
                    <obs id="AssessmentCheckboxRadio" conceptId="$@assessment(coded)@" answerConceptId="$@OTHER_NON-CODED@" answerLabel="Other" style="checkbox"/>
                    <span style="margin-left: 8px;">Specify:</span>
                    <obs conceptId="$@Other_Assessment@" size="40"/>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== FOLLOW-UP RECOMMENDATION ===== -->
    <div class="section-card">
        <div class="section-header">
            <span>📅</span>
            Follow-up Recommendation
        </div>
        <div class="section-content">
            <div class="followup-row">
                <span class="followup-label">Referral to another provider:</span>
                <obs conceptId="$@referred_to@" size="40"/>
            </div>

            <div class="followup-row">
                <span class="followup-label">U/S follow-up on:</span>
                <obs conceptId="$@Dates_of_Ultrasound_follow_up@" allowFutureDates="true"/>
                <div class="followup-options">
                    <span class="checkbox-item">
                        <obs conceptId="$@Reason_of_ultrasound_follow-up@" answerConceptId="$@Aspiration_or_drainage@" answerLabel="Aspiration or drainage" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Reason_of_ultrasound_follow-up@" answerConceptId="$@Core_needle_biopsy@" answerLabel="Core needle biopsy" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Reason_of_ultrasound_follow-up@" answerConceptId="$@Surgical_Biopsy@" answerLabel="Surgical biopsy" style="checkbox"/>
                    </span>
                    <span class="checkbox-item">
                        <obs conceptId="$@Reason_of_ultrasound_follow-up@" answerConceptId="$@Patient_discharged@" answerLabel="Patient discharged" style="checkbox"/>
                    </span>
                </div>
            </div>

            <div class="followup-row">
                <span class="followup-label">Follow-up breast exam on:</span>
                <obs conceptId="$@Date_of_breast_Follow-up_exam@" allowFutureDates="true"/>
                <p class="note-text">Note: If patient notes change in breast exam, she should return to clinic sooner.</p>
            </div>
        </div>
    </div>

    <!-- ===== PATHOLOGIC DIAGNOSIS ===== -->
    <div class="section-card">
        <div class="section-header">
            <span>🔬</span>
            For Masses Biopsied - Pathologic Diagnosis
        </div>
        <div class="section-content">
            <div class="form-row">
                <span class="inline-field">
                    <label class="form-label">Date of Report:</label>
                    <obs conceptId="$@Date_of_pathology_report@" allowFutureDates="true"/>
                </span>
            </div>

            <div class="divider"></div>

            <div class="form-row">
                <label class="form-label">Benign Findings</label>
                <div class="pathology-grid">
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@Fibroadenoma@" answerLabel="Fibroadenoma" style="checkbox"/>
                    </span>
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@Lactating_adenoma@" answerLabel="Lactating adenoma" style="checkbox"/>
                    </span>
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@CYST@" answerLabel="Cyst" style="checkbox"/>
                    </span>
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@Other_Benign@" answerLabel="Other benign" style="checkbox"/>
                        <span class="pathology-specify">
                            <label>Specify:</label>
                            <obs conceptId="$@Other_Benign@" size="20"/>
                        </span>
                    </span>
                </div>
            </div>

            <div class="divider"></div>

            <div class="form-row">
                <label class="form-label">Malignant Findings</label>
                <div class="pathology-grid">
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@Breast_carcinoma@" answerLabel="Breast carcinoma (In Situ or Invasive)" style="checkbox"/>
                    </span>
                    <span class="pathology-item">
                        <obs conceptId="$@Pathologic_diagnosis@" answerConceptId="$@Other_Malignant@" answerLabel="Other malignant" style="checkbox"/>
                        <span class="pathology-specify">
                            <label>Specify:</label>
                            <obs conceptId="$@Other_Malignant@" size="20"/>
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SUBMIT ===== -->
    <div class="submit-section">
        <submit submitLabel="Save Ultrasound Report" />
    </div>

    <!-- ===== VOIDED STATUS ===== -->
    <div class="voided-section">
        <encounterVoided />
    </div>

</htmlform>