<htmlform formName="Anesthesia Completion and Recovery"
          formUuid="3a4a28af-57b4-403f-90e3-9a46b0c2d9f4"
          formEncounterType="Anesthesia Record"
          formVersion="2.2">

    <style>
        form fieldset {
        display: block;
        }

        .section {
        width: 100%;
        }

        fieldset legend {
        font-weight: bold;
        padding: 10px;
        background-color: #f0f0f0;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin-bottom: 5px;
        display: block;
        }

        .section-container {
        background: #F2F2F2;
        box-shadow: 3px 3px 3px 1px rgba(0, 0, 0, 0.2);
        padding: 10px 5px 10px 15px;
        line-height: 1.5em;
        }

        .section-container label {
        margin: 0px;
        }

        form input[type="radio"],
        .form input[type="radio"] {
        float: none;
        display: inline-block;
        }

        .side-by-side label {
        display: inline-block;
        }

        .small-input input {
        min-width: 5em;
        }

        .flexView {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5em 1em;
        }

        .hasDatepicker {
        min-width: 120px;
        margin-top: 0px;
        }

        .hfe-hours,
        .hfe-minutes,
        .hfe-seconds {
        width: 70px;
        min-width: 70px;
        margin: 0px 10px 0px 10px;
        }

        .anesthesia-case-link {
        display: none;
        }
    </style>

    <div class="anesthesia-case-link">
        <anesthesiaCaseIdObs/>
        <obs conceptId="20150cc7-a7ef-460e-bb23-c03ada212c89" style="yes_no" defaultValue="true" required="true"/>
    </div>

    <h2>Anesthesia Completion &amp; Recovery / Fin d'anesthesie et reveil</h2>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="GENERAL INFORMATION / CONSULTATION">
        <div class="section-container">
            <table border="2" cellspacing="0" cellpadding="6" width="100%">
                <tr>
                    <td>
                        Date / Time:
                        <encounterDate default="now" showTime="true"/>
                    </td>
                    <td>
                        Location:
                        <encounterLocation default="GlobalProperty:billing.defaultLocation"/>
                    </td>
                    <td>
                        Provider:
                        <encounterProvider default="currentUser"/>
                    </td>
                </tr>
            </table>
        </div>
    </section>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="COMPLETION &amp; RECOVERY / FIN ET REVEIL">
        <div class="section-container">
            <p class="side-by-side">
                Airway technique / Technique
                <obs conceptId="0375a9d5-32d2-46aa-afd7-518bb7f66f28"
                     style="radio"
                     answerConceptIds="830186cd-e72a-4537-80b2-c2e9be1e3b9e,0f956919-d30f-4e42-88a0-7274cead8a09,f03d14e8-211d-4e91-ade5-9c24d02a9747"
                     answerLabels="Mask / Masque,Oral tube / Tube oral,Nasal tube / Tube nasal"/>
            </p>
            <p class="side-by-side">
                Position
                <obs conceptId="4080da65-d8dd-48a6-a90a-094866308d12"
                     style="radio"
                     answerConceptIds="2978d97a-8d63-4e6f-9ab3-9a775e497332,3b4807f8-ccd5-49ce-be05-d1d16621db9b,127c90b1-586f-4e1e-af4d-5c87aa6341dd"
                     answerLabels="Supine / Dorsale,Prone / Ventrale,Lateral / Laterale"/>
            </p>
            <p>
                Post-operative diagnosis / Diagnostic post-operatoire
                <obs conceptId="1c811683-d7f1-45f8-ac51-e7bf01344390" style="textarea" rows="3" cols="60"/>
            </p>
            <p>
                Remarks / Remarques
                <obs conceptId="8d3ea639-e9a4-43c7-b9bd-03556160b01d" style="textarea" rows="3" cols="60"/>
            </p>
            <p class="small-input flexView">
                Aldrete score (0-10)
                <obs conceptId="c20d3924-d2ff-420b-b0e2-bb0b6d9d18b1"/>
            </p>
        </div>
    </section>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <button id="submit" class="submitButton confirm">
                <uimessage code="Save"/><i class="icon-spinner icon-spin icon-2x" style="display: none; margin-left: 10px;"></i>
            </button>
            <button id="cancel" type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>
</htmlform>
