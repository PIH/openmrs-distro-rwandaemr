	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="REFERRAL INFORMATION">
		<div class="section-container">
			<fieldset>
				<legend><b>Referring Facility</b></legend>
				<table class="standard-table">
					<tr>
						<td>Type:</td>
						<td>
							<obs conceptId="c3e1d8d4-3040-49dd-ad66-c0928d912941" answerConceptIds="3ce0d300-26fe-102b-80cb-0017a47871b2,e3f356b2-a340-47df-8b87-b70224437833,da32efc3-f18c-404c-bab2-acf68f42f85c,3cee7fb4-26fe-102b-80cb-0017a47871b2,f9875828-50ed-45ee-9c72-b4f81e270a8f"
