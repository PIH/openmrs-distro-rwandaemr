	<style>
		form fieldset { display: block; margin-bottom: 10px; }
		.section-header { margin-top: 1.5em; }

		.section-container {
		background: #F2F2F2;
		box-shadow: 3px 3px 3px 1px rgba(0, 0, 0, 0.2);
		padding: 10px 5px 10px 15px;
		line-height: 1.5em;
		}

		table.standard-table { border: 2px solid #DDD; border-collapse: collapse; width: 100%; }
		table.standard-table td { padding: 8px; border: 1px solid #EEE; }

		.submitButton { margin-top: 20px; }
		.disabled { color: #D8D8D8; }
	</style>

	<h1>Oncology Program - Demographic Intake</h1>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="GENERAL INFORMATION">
		<div class="section-container">
			<table border="0" cellspacing="0" cellpadding="6" width="100%">
				<tr>
					<td>
						<b>Patient ID:</b>
						<lookup class="value" expression="patientIdentifiers.get(&quot;IMB ID&quot;)" />
					</td>
					<td>
						Date: <encounterDate default="today" />
					</td>
					<td>
						Clinic: <encounterLocation />
					</td>
				</tr>
				<tr>
					<td><b>Last Name:</b> <lookup class="value" expression="patient.personName.familyName" /></td>
					<td><b>First Name:</b> <lookup class="value" expression="patient.personName.givenName" /></td>
					<td><b>Provider:</b> <encounterProvider role="Oncology Provider" /></td>
				</tr>
			</table>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PATIENT DETAILS">
		<div class="section-container">
			<fieldset>
				<legend><b>Core Demographics</b></legend>
				<table class="standard-table">
					<tr>
						<td width="30%">Date of Birth</td>
						<td><lookup expression="patient.birthdate"/></td>
					</tr>
					<tr>
						<td>Sex</td>
						<td><lookup expression="patient.gender" codePrefix="gender_"/></td>
					</tr>
					<tr>
						<td>Residence</td>
						<td><addressHierarchyRwanda /></td>
					</tr>
				</table>
			</fieldset>

			<fieldset>
				<legend><b>Contact Information</b></legend>
				<table class="standard-table">
					<tr>
						<td width="30%">Primary Phone</td>
						<td><obs conceptId="3cda3d7e-26fe-102b-80cb-0017a47871b2" /></td>
					</tr>
					<tr>
						<td>Secondary Phone</td>
						<td><obs conceptId="55bd1ac5-d8aa-4fab-abb3-eb92c44e23e1" /></td>
					</tr>
				</table>
			</fieldset>
		</div>
	</section>

