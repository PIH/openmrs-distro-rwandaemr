					[ <obs conceptId="a9191adf-c999-422d-94e0-14de5f076127" answerConceptId="60faae3f-6f2c-4724-8a3e-96dfa386346e" answerLabel="I" />
					<obs conceptId="a9191adf-c999-422d-94e0-14de5f076127" answerConceptId="a184e124-75cf-4ecd-a724-ea068ea94438" answerLabel="II" />
					<obs conceptId="a9191adf-c999-422d-94e0-14de5f076127" answerConceptId="ddb21a09-f2df-490e-a6c4-22447a119492" answerLabel="III" /> ]
					<br/>
					<obs conceptId="3ce0cd1a-26fe-102b-80cb-0017a47871b2" answerConceptId="3cee7fb4-26fe-102b-80cb-0017a47871b2" answerLabel="Other:" />
					<obs conceptId="bab86ae4-080a-4e83-8808-faa9863d9a61" />
					<br/>
					<obs conceptId="8da67e73-776c-43f6-9758-79d1f6786db3" answerConceptId="3cd743f8-26fe-102b-80cb-0017a47871b2" answerLabel="None" />
				</div>
			</fieldset>

			<fieldset>
				<legend><b>Recommended Socioeconomic Assistance</b></legend>
				<div class="two-columns">
					<obs conceptId="3ce16b30-26fe-102b-80cb-0017a47871b2" answerConceptId="3cda0eee-26fe-102b-80cb-0017a47871b2" answerLabel="Food supplementation" /><br/>
					<obs conceptId="3ce16b30-26fe-102b-80cb-0017a47871b2" answerConceptId="3cd67432-26fe-102b-80cb-0017a47871b2" answerLabel="Transport" /><br/>
					<obs conceptId="3ce16b30-26fe-102b-80cb-0017a47871b2" answerConceptId="262dba46-b8b0-4dd4-9edc-9bac0a7932cc" answerLabel="Home visits" /><br/>
