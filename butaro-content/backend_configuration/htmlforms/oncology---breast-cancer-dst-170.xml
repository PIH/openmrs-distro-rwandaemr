				<obs conceptId="$@LOCATION_OF_PATHOLOGY@" answerConceptId="$@BUTARO_HOSPITAL@" answerLabel="BUTARO" />
				<obs conceptId="$@LOCATION_OF_PATHOLOGY@" answerConceptId="$@KFH@" answerLabel="KFH" />
