					<div>
						<label>If HIV Positive:</label><br/>
						CD4 Count at time of Dx: <obs conceptId="$@CD4_COUNT@" /> /mm<sup>3</sup>
						<br/><br/>
						On ARVs at time of cancer Dx:
						<obs conceptId="$@ON_ARVS_AT_DIAGNOSIS@" answerConceptId="$@YES@" answerLabel="Yes" />
						<obs conceptId="$@ON_ARVS_AT_DIAGNOSIS@" answerConceptId="$@NO@" answerLabel="No" />
						<obs conceptId="$@ON_ARVS_AT_DIAGNOSIS@" answerConceptId="$@UNKNOWN@" answerLabel="Unknown" />
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend><b>Imaging</b></legend>

				<obs conceptId="$@IMAGING_STUDIES@" answerConceptId="$@X-RAY_CHEST@" answerLabel="Chest X-ray"
					 showDate="true" dateLabel="Study Date:" />
				<br/>
				<obs conceptId="$@IMAGING_STUDIES@" answerConceptId="$@ABDOMINAL_ULTRASOUND@"
					 answerLabel="Abdominal (or liver) ultrasound" showDate="true" dateLabel="Study Date:" />
				<br/>
				<obs conceptId="$@IMAGING_STUDIES@" answerConceptId="$@CT_CHEST@" answerLabel="CT scan of chest"
					 showDate="true" dateLabel="Study Date:" />
				<br/>
				<obs conceptId="$@IMAGING_STUDIES@" answerConceptId="$@CT_ABDOMEN_PELVIS@"
					 answerLabel="CT scan of Abdomen/pelvis" showDate="true" dateLabel="Study Date:" />
				<br/>
				<obs conceptId="$@IMAGING_STUDIES@" answerConceptId="$@OTHER_NON_CODED@" answerLabel="Other"
					 showDate="true" dateLabel="Study Date:" />
				<br/><br/>

				<label>Imaging Assessment:</label><br/>
				<obs conceptId="$@IMAGING_ASSESSMENT@" rows="4" cols="90" style="textarea" />
			</fieldset>

			<obsgroup groupingConceptId="$@PRE_SURGERY_CONSTRUCT@">
				<fieldset>
					<legend><b>Clinical Stage (current presentation)</b></legend>

					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@EARLY_STAGE@" answerLabel="Early Stage" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@LOCALLY_ADVANCED@" answerLabel="Locally Advanced" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@METASTATIC@" answerLabel="Metastatic" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@RECURRENT@" answerLabel="Recurrent" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@UNABLE_TO_DETERMINE@"
						 answerLabel="Unable to determine" />
					<br/><br/>

					<label>Clinical TNM, if available:</label>
					T<obs conceptId="$@TUMOR_TNM@" />
					N<obs conceptId="$@NODE_TNM@" />
					M<obs conceptId="$@METASTESES_TNM@" />
					<br/><br/>

					<label>Stage:</label>
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_ZERO@" answerLabel="0" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_ONE@" answerLabel="I" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_TWO@" answerLabel="II" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_THREE@" answerLabel="III" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_FOUR@" answerLabel="IV" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@UNABLE_TO_DETERMINE@"
						 answerLabel="Unable to determine" />
				</fieldset>
			</obsgroup>

			<obsgroup groupingConceptId="$@POST_SURGERY_CONSTRUCT@">
				<fieldset>
					<legend><b>Pathologic Stage (from MRM/ALND, if post-operative)</b></legend>

					<label>Overall stage (if post-operative):</label>
					pT<obs conceptId="$@TUMOR_TNM@" />
					N<obs conceptId="$@NODE_TNM@" />
					M<obs conceptId="$@METASTESES_TNM@" />
					<br/><br/>

					<label>Stage:</label>
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_ZERO@" answerLabel="0" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_ONE@" answerLabel="I" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_TWO@" answerLabel="II" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_THREE@" answerLabel="III" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@OVERALL_CANCER_STAGE_FOUR@" answerLabel="IV" />
					<obs conceptId="$@OVERALL_ONCOLOGY_STAGE@" answerConceptId="$@UNABLE_TO_DETERMINE@"
						 answerLabel="Unable to determine" />
				</fieldset>
			</obsgroup>

			<fieldset>
				<legend><b>Operative Findings (if applicable)</b></legend>

				<label>Tumor resection margins:</label>
				<obs conceptId="$@TUMOR_RESECTION_MARGINS@" answerConceptId="$@POSITIVE@" answerLabel="Positive" />
				<obs conceptId="$@TUMOR_RESECTION_MARGINS@" answerConceptId="$@NEGATIVE@" answerLabel="Negative" />
				<obs conceptId="$@TUMOR_RESECTION_MARGINS@" answerConceptId="$@UNABLE_TO_DETERMINE@"
					 answerLabel="Unable to determine" />
				<br/><br/>

				<label>Lymph node sampling:</label>
				<obs conceptId="$@LYMPH_NODES_MALIGNANT@" /> out of
				<obs conceptId="$@LYMPH_NODES_SAMPLED@" /> sampled lymph nodes positive for malignancy
				<br/><br/>

				<label>Other operative findings:</label><br/>
				<obs conceptId="$@OTHER_OPERATIVE_FINDINGS@" rows="2" cols="90" style="textarea" />
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="TREATMENT PLAN">
		<div class="section-container">
			<fieldset>
				<legend><b>Treatment Intent</b></legend>

				<obs conceptId="$@TREATMENT_INTENT@" answerConceptId="$@LONG-TERM_DISEASE_CONTROL@" answerLabel="Curative" />
				<obs conceptId="$@TREATMENT_INTENT@" answerConceptId="$@PALLIATIVE_SYSTEMIC@"
					 answerLabel="Palliative cancer therapy" />
				<obs conceptId="$@TREATMENT_INTENT@" answerConceptId="$@PALLIATION@" answerLabel="Palliative Care Only" />
			</fieldset>

			<fieldset>
				<legend><b>Neoadjuvant</b></legend>

				<obs conceptId="$@NEOADJUVANT@" answerConceptId="$@PLANNED@" answerLabel="Planned" />
				<obs conceptId="$@NEOADJUVANT@" answerConceptId="$@NOT_PLANNED@" answerLabel="Not planned" />
				<obs conceptId="$@NEOADJUVANT@" answerConceptId="$@NA@" answerLabel="Not applicable" />
				<br/><br/>

				<obs conceptId="$@NEOADJUVANT_TYPE@" answerConceptId="$@AC+T@" answerLabel="AC+T" />
				<obs conceptId="$@NEOADJUVANT_TYPE@" answerConceptId="$@HORMONAL@" answerLabel="Hormonal" />
				<obs conceptId="$@NEOADJUVANT_TYPE@" answerConceptId="$@OTHER_NON_CODED@" answerLabel="Other" />
				<obs conceptId="$@OTHER_NEOADJUVANT@" />
			</fieldset>

			<fieldset>
				<legend><b>Surgery</b></legend>

				<obs conceptId="$@SURGERY_STATUS@" answerConceptId="$@PLANNED@" answerLabel="Planned" />
				<obs conceptId="$@SURGERY_STATUS@" answerConceptId="$@NOT_PLANNED@" answerLabel="Not planned" />
				<obs conceptId="$@SURGERY_STATUS@" answerConceptId="$@NA@" answerLabel="Not applicable" />
			</fieldset>

			<fieldset>
				<legend><b>Adjuvant</b></legend>

				<obs conceptId="$@ADJUVANT@" answerConceptId="$@PLANNED@" answerLabel="Planned" />
				<obs conceptId="$@ADJUVANT@" answerConceptId="$@NOT_PLANNED@" answerLabel="Not planned" />
				<obs conceptId="$@ADJUVANT@" answerConceptId="$@NA@" answerLabel="Not applicable" />
				<br/><br/>

				<obs conceptId="$@ADJUVANT_TYPE@" answerConceptId="$@AC+T@" answerLabel="AC+T" />
				<obs conceptId="$@ADJUVANT_TYPE@" answerConceptId="$@HORMONAL@" answerLabel="Hormonal" />
				<obs conceptId="$@ADJUVANT_TYPE@" answerConceptId="$@OTHER_NON_CODED@" answerLabel="Other" />
				<obs conceptId="$@OTHER_ADJUVANT@" />
			</fieldset>

			<fieldset>
				<legend><b>Radiotherapy</b></legend>

				<obs conceptId="$@RADIATION_STATUS@" answerConceptId="$@PLANNED@" answerLabel="Planned" />
				<obs conceptId="$@RADIATION_STATUS@" answerConceptId="$@NOT_PLANNED@" answerLabel="Not planned" />
				<obs conceptId="$@RADIATION_STATUS@" answerConceptId="$@NA@" answerLabel="Not applicable" />
			</fieldset>

			<fieldset>
				<legend><b>Palliative Cancer Therapy</b></legend>

				<obs conceptId="$@PALLIATIVE_CANCER_THERAPY_STATUS@" answerConceptId="$@PLANNED@" answerLabel="Planned" />
				<obs conceptId="$@PALLIATIVE_CANCER_THERAPY_STATUS@" answerConceptId="$@NOT_PLANNED@"
					 answerLabel="Not planned" />
				<obs conceptId="$@PALLIATIVE_CANCER_THERAPY_STATUS@" answerConceptId="$@NA@" answerLabel="Not applicable" />
				<br/><br/>

				<obs conceptId="$@PALLIATION_TYPE@" answerConceptId="$@TAXOL@" answerLabel="Single agent paclitaxel" />
				<obs conceptId="$@PALLIATION_TYPE@" answerConceptId="$@HORMONAL@" answerLabel="Hormonal" />
				<obs conceptId="$@PALLIATION_TYPE@" answerConceptId="$@OTHER_NON_CODED@" answerLabel="Other" />
				<obs conceptId="$@OTHER_PALLIATION_TYPE@" />
			</fieldset>

			<fieldset>
				<legend><b>Planned Changes to Protocol Treatment Plan</b></legend>

				<obs conceptId="$@PLANNED_TREATMENT_CHANGES@" rows="4" cols="90" style="textarea" />
			</fieldset>

			<fieldset>
				<legend><b>Additional Comments</b></legend>

				<obs conceptId="$@COMMENTS@" rows="4" cols="90" style="textarea" />
			</fieldset>
		</div>
	</section>

	<ifMode mode="VIEW" include="false">
		<div id="buttons">
			<button id="submit" class="submitButton confirm right">
				<uimessage code="Save" />
