			<fieldset>
				<legend><b>Method of Delivery</b></legend>

				<obs conceptId="$@METHOD_OF_DELIVERY_OF_DRUGS@"
					 answerConceptId="$@ZIPLINE@"
					 answerLabel="Zipline"/>
				<br/>
				<obs conceptId="$@METHOD_OF_DELIVERY_OF_DRUGS@"
					 answerConceptId="$@IMB_BUS@"
					 answerLabel="IMB bus deliver"/>
