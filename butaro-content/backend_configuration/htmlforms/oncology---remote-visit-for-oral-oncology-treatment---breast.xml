	<h1>Remote Visit for Oral Oncology Treatment - Breast Cancer</h1>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PATIENT INFORMATION">
		<div class="section-container">
			<table border="2" cellspacing="0" cellpadding="6" width="100%">
				<tr>
					<td>
						<b>IMB ID:</b>
						<lookup class="value" expression="patientIdentifiers.get(&quot;IMB ID&quot;)" />
						<lookup class="value" expression="patientIdentifiers.get(&quot;IMB Primary Care Registration ID&quot;)" />
					</td>
					<td>
						Date:
						<encounterDate id="encounterDate" default="today" />
					</td>
				</tr>
				<tr>
					<td>
						Last name:
						<lookup class="value" expression="patient.personName.familyName" />
					</td>
					<td>
						First name:
						<lookup class="value" expression="patient.personName.givenName" />
					</td>
				</tr>
				<tr>
					<td>
						Clinic:
						<encounterLocation id="encounterLocation" default="Butaro Hospital" />
					</td>
					<td>
						Provider:
						<encounterProvider id="encounterProvider" role="Oncology Provider" />
					</td>
				</tr>
			</table>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="DIAGNOSIS AND TREATMENT INTENT">
		<div class="section-container">
			<fieldset>
				<legend><b>Diagnosis: Breast Cancer</b></legend>

				<label>Treatment Intent (From Chart):</label><br/>
				<obs conceptId="$@TREATMENT_INTENT@"
					 answerConceptId="$@CURATIVE@"
					 answerLabel="Adjuvant therapy (Curative)" />
				<obs conceptId="$@TREATMENT_INTENT@"
					 answerConceptId="$@PALLIATION@"
					 answerLabel="Palliative intent (Palliative)" />
			</fieldset>

			<fieldset>
				<legend><b>Family Planning</b></legend>

				<p><i>For women 50 and younger and men on Tamoxifen, confirm they are using family planning. All pre-menopausal women and all men on therapy should use family planning.</i></p>

				<obs conceptId="$@FAMILY_PLANNING@"
					 answerConceptId="$@NA@"
					 answerLabel="Not applicable (not sexually active, menopausal women)" />
				<br/>
				<obs conceptId="$@FAMILY_PLANNING@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes, using family planning" />
				<br/>
				<obs conceptId="$@FAMILY_PLANNING@"
					 answerConceptId="$@NO@"
					 answerLabel="No, not using family planning" />
				<obs conceptId="$@NO_FAMILY_PLANNING_REASON@" size="60"/>
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="TOXICITY SCREENING">
		<div class="section-container">
			<p><b>Clinical questions for all (Toxicity):</b></p>
			<p><i>If the patient answers YES to any of the questions below, complete form, do not renew medication and refer to MD</i></p>

			<fieldset>
				<legend><b>Toxicity Assessment</b></legend>

				<label>Have you had any new (or recent) pain, swelling or warmth in your lower legs or arms? (Signs and symptoms of vein thrombosis)</label><br/>
				<obs conceptId="$@LEG_PAIN@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes" />
				<obs conceptId="$@LEG_PAIN@"
					 answerConceptId="$@NO@"
					 answerLabel="No" />
				<br/><br/>

				<label>Have you developed a new or worsening cough, any shortness of breath or chest pain? (Signs and symptoms of pulmonary embolism)</label><br/>
				<obs conceptId="$@RESPIRATORY_SYMPTOMS@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes" />
				<obs conceptId="$@RESPIRATORY_SYMPTOMS@"
					 answerConceptId="$@NO@"
					 answerLabel="No" />
				<br/><br/>

				<label>Have you had any new or unusual vaginal bleeding? (Signs and symptoms endometrial cancer)</label><br/>
				<obs conceptId="$@VAGINAL_BLEEDING@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes" />
				<obs conceptId="$@VAGINAL_BLEEDING@"
					 answerConceptId="$@NO@"
					 answerLabel="No" />
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="SYMPTOM ASSESSMENT">
		<div class="section-container">
			<p><i>For the questions below, if the patient feels worse, has increased pain or has other serious concerns, complete form, do not renew medication and refer to MD</i></p>

			<fieldset>
				<legend><b>General Symptoms</b></legend>

				<label>In the past month are you feeling:</label><br/>
				<obs conceptId="$@HOW_FEELING@"
					 answerConceptId="$@BETTER@"
					 answerLabel="Better"/>
				<obs conceptId="$@HOW_FEELING@"
					 answerConceptId="$@SAME@"
					 answerLabel="Same"/>
				<obs conceptId="$@HOW_FEELING@"
					 answerConceptId="$@WORSE@"
					 answerLabel="Worse"/>
				<br/><br/>
				<label>If worse, describe:</label>
				<obs conceptId="$@WORSE_DESCRIPTION@" size="60"/>
				<br/><br/>

				<label>Do you have any pain?</label><br/>
				<obs conceptId="$@IN_PAIN@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@IN_PAIN@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<br/><br/>

				<label>If yes, has the pain:</label><br/>
				<obs conceptId="$@PAIN_CHANGES@"
					 answerConceptId="$@BETTER@"
					 answerLabel="Gotten Better"/>
				<obs conceptId="$@PAIN_CHANGES@"
					 answerConceptId="$@SAME@"
					 answerLabel="Stayed the same"/>
				<obs conceptId="$@PAIN_CHANGES@"
					 answerConceptId="$@WORSE@"
					 answerLabel="Gotten Worse"/>
				<br/><br/>

				<label>Do you have any other new concerns?</label><br/>
				<obs conceptId="$@CONCERNS_SHARED@" rows="4" cols="60"/>
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="METASTATIC PATIENTS">
		<div class="section-container">
			<p><i>If the patient's cancer has increased in size, or they have new masses or lumps, complete form, do not renew medication and refer to MD</i></p>
			<p><b>Clinical questions for metastatic patient on hormones for palliative intent (Response Assessment):</b></p>

			<fieldset>
				<legend><b>Disease Response Assessment</b></legend>

				<label>Has the size of your cancer mass:</label><br/>
				<obs conceptId="$@CHANGE_IN_MASS_SIZE@"
					 answerConceptId="$@SMALLER@"
					 answerLabel="gotten smaller"/>
				<obs conceptId="$@CHANGE_IN_MASS_SIZE@"
					 answerConceptId="$@SAME@"
					 answerLabel="stayed the same"/>
				<obs conceptId="$@CHANGE_IN_MASS_SIZE@"
					 answerConceptId="$@BIGGER@"
					 answerLabel="gotten bigger"/>
				<br/><br/>

				<label>Do you have any new masses or lumps?</label><br/>
				<obs conceptId="$@NEW_MASSES@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@NEW_MASSES@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="MEDICATION ADHERENCE">
		<div class="section-container">
			<fieldset>
				<legend><b>Medication Adherence Questionnaire</b></legend>

				<label>As of today, have you run out of your daily oral medication?</label><br/>
				<obs conceptId="$@RUN_OUT_OF_MEDS@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@RUN_OUT_OF_MEDS@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<br/><br/>

				<label>How long have you been without medication?</label>
				<obs conceptId="$@DAYS_WITHOUT_MEDS@"/> Days
				<br/><br/>

				<p><i>If the patient answers NO to the question above, proceed with the next 5 questions</i></p>
				<br/>

				<obs conceptId="$@EVER_MISS_MEDS@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@EVER_MISS_MEDS@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<label>Do you ever forget to take your medication?</label>
				<br/><br/>

				<obs conceptId="$@CARELESS_ABOUT_MEDS@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@CARELESS_ABOUT_MEDS@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<label>Are you careless at times about taking your medication?</label>
				<br/><br/>

				<obs conceptId="$@STOP_MEDS_BECAUSE_FEEL_WORSE@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@STOP_MEDS_BECAUSE_FEEL_WORSE@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<label>Sometimes if you feel worse, do you stop taking your medication?</label>
				<br/><br/>

				<obs conceptId="$@STOP_MEDS_BECAUSE_FEEL_BETTER@"
					 answerConceptId="$@YES@"
					 answerLabel="Yes"/>
				<obs conceptId="$@STOP_MEDS_BECAUSE_FEEL_BETTER@"
					 answerConceptId="$@NO@"
					 answerLabel="No"/>
				<label>Sometimes if you feel better, do you stop taking your medication?</label>
				<br/><br/>

				<label>Thinking about the last week, how often have you not taken your medication?</label><br/>
				<obs conceptId="$@HOW_MANY_MED_MISSES@"
					 answerConceptId="$@NEVER@"
					 answerLabel="Never"/>
				<obs conceptId="$@HOW_MANY_MED_MISSES@"
					 answerConceptId="$@ONE@"
					 answerLabel="One Time"/>
				<obs conceptId="$@HOW_MANY_MED_MISSES@"
					 answerConceptId="$@2_3@"
					 answerLabel="2-3 times"/>
				<obs conceptId="$@HOW_MANY_MED_MISSES@"
					 answerConceptId="$@4_5@"
					 answerLabel="4-5 times"/>
				<obs conceptId="$@HOW_MANY_MED_MISSES@"
					 answerConceptId="$@5+@"
					 answerLabel="More than 5 times"/>
			</fieldset>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="CLINICAL DECISION AND PLAN">
		<div class="section-container">
			<p><i>Depending on the answers to the above assessment, refer to MD for further evaluation or renew prescription and make arrangements for patient to get the medication</i></p>

			<fieldset>
				<legend><b>Nurse Clinical Decision</b></legend>

				<obs conceptId="$@NURSE_CLINICAL_DECISION@"
					 answerConceptId="$@CONTINUE_REGIMEN@"
					 answerLabel="Continue medication as before"/>
				<br/>
				<obs conceptId="$@NURSE_CLINICAL_DECISION@"
					 answerConceptId="$@REFER_TO_MD@"
					 answerLabel="If severe symptoms or increased size of mass, new masses or increased pain, refer to MD for further evaluation"/>
				<br/><br/>

				<label>Additional Comments:</label><br/>
				<obs conceptId="$@TREATMENT_COMMENTS@" rows="4" cols="60"/>
			</fieldset>

			<fieldset>
				<legend><b>Medication Order</b></legend>

				<drugOrder orderType="131168f4-15f5-102d-96e4-000c29c2a5d7" selectLabel="Order Drug">
					<orderTemplate>
						<orderProperty name="drug" label="Drug*">
							<option value="$@TAMOXIFEN@" />
							<option value="$@LETROZOLE@" />
						</orderProperty>
						<orderProperty name="action">
							<option value="NEW" label="Place a new Order"/>
							<option value="REVISE" label="Revise this Order"/>
							<option value="RENEW" label="Renew this Order"/>
							<option value="DISCONTINUE" label="Discontinue this Order"/>
						</orderProperty>
						<div style="padding:0px;">
							<orderProperty name="dose" label="Dose*"/>
							<orderProperty name="doseUnits" label="Units*">
								<option value="4020" label="tablets"/>
								<option value="05d778f0-6282-4eed-9c58-6b5d0703c5a7" label="milligrams"/>
								<option value="07b05a2a-87ff-44ce-bb5c-5d6855bf8b11" label="units"/>
							</orderProperty>
							<orderProperty name="frequency" label="Frequency*">
								<option value="707ad8b7-d902-11ea-80fb-0242ac110002" label="1 / day"/>
								<option value="87ea7c89-d8f9-11ea-80fb-0242ac110002" label="2 / day"/>
								<option value="d8290a00-d926-11ea-8b36-0242ac110002" label="3 / day"/>
								<option value="405a5af1-d927-11ea-8b36-0242ac110002" label="4 / day"/>
								<option value="405a5af1-d927-11ea-8b36-0242ac110002" label="5 / day"/>
								<option value="f11513cb-eee1-11ea-b492-0242ac110002" label="6 / day"/>
								<option value="9212ab7b-eee4-11ea-b492-0242ac110002" label="7 / day"/>
							</orderProperty>
						</div>
						<orderProperty name="asNeeded"/>
						<div style="padding:0px;">
							<orderProperty name="dateActivated"/>
							<orderProperty name="duration" label="Duration in days (blank=no end)"/>
						</div>
						<div style="display:none;">
							<orderProperty name="dateActivated"/>
							<orderProperty name="route" value="3327" />
							<orderProperty name="urgency" value="ROUTINE"/>
							<orderProperty name="dosingType" value="org.openmrs.SimpleDosingInstructions"/>
							<orderProperty name="instructions" textArea="true" textAreaRows="4" textAreaColumns="100"/>
							<orderProperty name="previousOrder"/>
