  <script type="text/javascript">
    $j(document).ready(function () {
      $j.each(["familyHistory", "medicalHistory"], function (index, history) {
        var radios = $j("#" + history + "Question input[type='radio']");
        var details = $j("#" + history + "DetailsSection");
        var updateHistoryDetails = function () {
          var hasHistory = radios.first().is(":checked");
          details.toggle(hasHistory);
          if (!hasHistory) {
            details.find("input[type='text'], textarea").val("").change();
          }
        };
        radios.change(updateHistoryDetails);
        updateHistoryDetails();
      });
    });
