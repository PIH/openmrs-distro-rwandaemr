<htmlform
        htmlformUuid="ecb87749-181d-46e6-8d7a-944fc64cc270"
        formUuid="dae6c34d-6de7-4fa3-98a1-dd19df75f054"
        formName="Oncology Outpatient - Pathology Report"
        formDescription="Standardized pathology specimen and result tracking"
        formVersion="1.1"
        formEncounterType="ff319885-3f20-4ae5-8663-3ad5678cba41"
        formPublished="true"
        formRetired="false"
>
    <style>
        .section-container {
        background: #F2F2F2;
        box-shadow: 3px 3px 3px 1px rgba(0, 0, 0, 0.2);
        padding: 10px 5px 10px 15px;
        line-height: 1.5em;
        }
        .standard-table { border: 2px solid #DDD; border-collapse: collapse; width: 100%; }
        .standard-table td { padding: 8px; border: 1px solid #EEE; vertical-align: top; }
        .clinical-history { background-color: #e7f3f2; padding: 10px; border-left: 4px solid #009d8e; margin: 10px 0; }
        h1, h2 { color: #009d8e; }
    </style>

    <h1>Oncology Pathology Report</h1>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="GENERAL INFORMATION">
        <div class="section-container">
            <table border="0" width="100%">
                <tr>
                    <td><b>IMB ID:</b> <lookup class="value" expression="patientIdentifiers.get(&quot;IMB ID&quot;)" /></td>
                    <td><b>Date:</b> <encounterDate id="encounterDate" default="today" /></td>
                </tr>
                <tr>
                    <td><b>Nom/Last Name:</b> <lookup class="value" expression="patient.personName.familyName" /></td>
                    <td><b>Prénom/First Name:</b> <lookup class="value" expression="patient.personName.givenName" /></td>
                </tr>
                <tr>
                    <td><b>Clinic:</b> <encounterLocation id="encounterLocation" default="Butaro Hospital" /></td>
                    <td><b>Reporting Doctor:</b> <encounterProvider role="Oncology Provider" /></td>
                </tr>
            </table>
        </div>
    </section>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PROCEDURE AND SPECIMEN">
        <div class="section-container">
            <div class="two-columns">
                <div>
                    <fieldset>
                        <legend>Biopsy Procedure</legend>
                        <table width="100%">
                            <tr>
                                <td><b>Date of Procedure:</b></td>
                                <td><obs conceptId="$@Date_Biopsy_Specimen_Taken@"/></td>
                            </tr>
                        </table>
                        <p><b>Facility of Procedure:</b></p>
                        <obs conceptId="$@Hospital_of_Origin@" answerConceptId="$@Butaro_Hospital@" answerLabel="Butaro" style="checkbox"/>
                        <obs conceptId="$@Hospital_of_Origin@" answerConceptId="$@RWINKWAVU@" answerLabel="Rwinkwavu" style="checkbox"/>
                        <obs conceptId="$@Hospital_of_Origin@" answerConceptId="$@OTHER_NON-CODED@" answerLabel="Other" style="checkbox"/>
                        <obs conceptId="$@Other_Biopsy_Location@"/>
                    </fieldset>
                </div>
                <div>
                    <fieldset>
                        <legend>Specimen Handling</legend>
                        <table width="100%">
                            <tr>
                                <td><b>Date Received:</b></td>
                                <td><obs conceptId="$@DATE_OF_SPECIMEN_RECEIVED@"/></td>
                            </tr>
                        </table>
                        <p><b>Anatomical Source Documentation:</b></p>

                        <obs conceptId="$@Other_Tissue_Source@" style="textarea" rows="2" cols="40" placeholder="Describe tissue source..."/>
                    </fieldset>
                </div>
            </div>
        </div>
    </section>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PATHOLOGY EXAMINATION">
        <div class="section-container">
            <fieldset>
                <legend>Processing Details</legend>
                <table width="100%">
                    <tr>
                        <td><b>Pathology Lab:</b></td>
                        <td>
                            <obs conceptId="$@Location_of_pathology@" answerConceptId="$@Butaro_Hospital@" answerLabel="Butaro" style="checkbox"/>
                            <obs conceptId="$@Location_of_pathology@" answerConceptId="$@Brigham_Womans_Hospital@" answerLabel="BWH" style="checkbox"/>
                            <obs conceptId="$@Location_of_pathology,Non-coded@"/>
                        </td>
                    </tr>
                    <tr>
                        <td><b>Pathologist:</b></td>
                        <td><obs conceptId="$@Pathologist@"/></td>
                    </tr>
                </table>
                <div class="clinical-history">
                    <b>Clinical History Provided to Lab:</b><br/>
                    <obs conceptId="$@Clinical_History,non-coded@" style="textarea" rows="3" cols="100"/>
                </div>
            </fieldset>

            <fieldset>
                <legend>Macroscopic Description</legend>

                <obs conceptId="$@Gross_Description@" style="textarea" rows="4" cols="100"/>
            </fieldset>
        </div>
    </section>

    <section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PATHOLOGIC DIAGNOSIS">
        <div class="section-container">
            <fieldset style="border: 2px solid #009d8e;">
                <legend style="color: #009d8e;"><b>Final Result</b></legend>
                <p><b>Diagnosis:</b></p>
                <obs conceptId="$@Pathologic_diagnosis,_non-coded@" style="textarea" rows="5" cols="100"/>

                <p><b>Conclusion / Recommendations:</b></p>
                <obs conceptId="$@COMMENTS_AT_CONCLUSION_OF_EXAMINATION@" style="textarea" rows="4" cols="100"/>
            </fieldset>

            <fieldset>
                <legend>Report Attachments</legend>
                <p><i>Attach scanned copies of original pathology reports:</i></p>
                <table class="standard-table">
                    <tr>
                        <td>1. <obs conceptId="$@Non-Image_attachment@"/></td>
                        <td>2. <obs conceptId="$@Non-Image_attachment@"/></td>
                    </tr>
                    <tr>
                        <td>3. <obs conceptId="$@Non-Image_attachment@"/></td>
                        <td>4. <obs conceptId="$@Non-Image_attachment@"/></td>
                    </tr>
                </table>
            </fieldset>
        </div>
    </section>

    <div style="text-align: center; padding: 20px;">
        <submit />
    </div>

    <encounterVoided/>
</htmlform>