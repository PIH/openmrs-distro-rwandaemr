  <script type="text/javascript">
    if (jQuery) {
      $j(document).ready(function () {
        var dispositionRadios = $j(".disposition-options input[type='radio']");
        var updateReferredFacility = function () {
          // The facility-name field belongs only to the Referred to facility choice.
          var referred = dispositionRadios.eq(4).is(":checked");
          var facilitySection = $j("#referredFacilitySection");
          facilitySection.toggle(referred);
          if (!referred) {
            facilitySection.find("input[type='text'], textarea, select").val("").change();
          }
        };
        dispositionRadios.change(updateReferredFacility);
        updateReferredFacility();

        var ultrasoundRadios = $j("#ultrasoundRequestRow input[type='radio']");
        var remainingSectionsHidden = function () {
          return ultrasoundRadios.first().is(":checked");
        };
        var clearRemainingSections = function () {
          var sections = $j(".ultrasound-remaining");
          var choices = sections.find("input[type='checkbox'], input[type='radio']");
          choices.prop("checked", false);
          // Clear both displayed values and hidden date/autocomplete values.
          var fields = sections.find("input, select, textarea")
            .not(":checkbox, :radio, :button, :submit, :reset");
          fields.val("");
          sections.find(".hasDatepicker").each(function () {
            $j(this).datepicker("setDate", null);
          });
          choices.add(fields).change();
        };
        var updateUltrasoundSections = function () {
          if (remainingSectionsHidden()) {
            clearRemainingSections();
          }
          $j(".ultrasound-remaining").toggle(!remainingSectionsHidden());
          $j("#dispositionRequiredError").hide();
        };
        ultrasoundRadios.change(updateUltrasoundSections);
        updateUltrasoundSections();

        // Disposition is required only when completing the remaining sections.
        beforeSubmit.push(function () {
          if (remainingSectionsHidden()) {
            clearRemainingSections();
          }
          var missingDisposition = !remainingSectionsHidden() &amp;&amp; !getValue("disposition.value");
          $j("#dispositionRequiredError").toggle(missingDisposition);
          return !missingDisposition;
        });

        $j(".checkboxGroup").each(function () {
          var group = $j(this);
          var uncheckAll = function () {
            group.find("input[type$='checkbox']").attr("checked", false);
            group.find("input[type$='checkbox']").change();
          };
          var uncheckRadioAndAll = function () {
            group
              .find("#checkboxAll,#checkboxRadio")
              .find("input[type$='checkbox']")
              .attr("checked", false);
            group
              .find("#checkboxAll,#checkboxRadio")
              .find("input[type$='checkbox']")
              .change();
          };
          group
            .find("#checkboxRadio")
            .find("input[type$='checkbox']")
            .click(function () {
              uncheckAll();
              $j(this).siblings("input[type$='checkbox']").attr("checked", false);
              $j(this).attr("checked", true);
              $j(this).change();
            });
        });
        $j("input[type=radio]").change(function () {
          // Find the associated textarea based on the name attribute of the radio button
          var textarea = $j(this).closest("td").find("textarea");
          // Update the textarea value based on the selected radio button value
          if ($j(this).val() === "normal") {
            textarea.val("Normal");
          } else if ($j(this).val() === "abnormal") {
            textarea.val("Abnormal because:");
          }
        });
      });
    }
  </script>
