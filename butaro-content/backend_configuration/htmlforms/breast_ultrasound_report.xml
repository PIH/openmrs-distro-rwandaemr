  <script type="text/javascript">
    // Adapted from the supplied script. Scope handlers to this report and use
    // checked properties so that both user clicks and HFE change handlers agree.
    if (typeof jQuery !== "undefined") {
      jQuery(function ($j) {
        var report = $j(".bur");
        report.find(".checkboxGroup").each(function () {
          var group = $j(this);
          var exclusive = group.find(".checkboxRadio input[type='checkbox']");
          var alternatives = group.find(".checkboxOther input[type='checkbox']");
          var months = group.find(
            "#ultrasoundFollowupMonths input[type='text'], #ultrasoundFollowupMonths input[type='number']",
          );
          var uncheckAll = function () {
            alternatives.filter(":checked").prop("checked", false).change();
            months.val("").change();
          };
          var uncheckRadioAndAll = function () {
            exclusive.filter(":checked").prop("checked", false).change();
          };
          exclusive.change(function () {
            if ($j(this).is(":checked")) {
              uncheckAll();
            }
          });
          alternatives.change(function () {
            if ($j(this).is(":checked")) {
              uncheckRadioAndAll();
            }
          });
          months.change(function () {
            if ($j.trim($j(this).val()) !== "") {
              uncheckRadioAndAll();
            }
          });
        });
        // HFE clears hidden inputs without firing their change handlers. Refresh
        // nested controllers after the parent's native handler has finished, so
        // reopening a cleared section cannot reveal stale child branches.
        setTimeout(function () {
          if (typeof getField !== "function") {
            return;
          }
          // Keep the existing single coded margin observation. Move its four
          // detailed choices below the main choices instead of creating a
          // second observation for the same question.
          var margins = getField("lesionMargins.value");
          var marginDetails = $j('&lt;div class="margin-details"&gt;&lt;/div&gt;');
          var detailedValues = [];
          var nonCircumscribedValue;
          margins.each(function () {
            var input = $j(this);
            var label = input.next("label");
            var text = $j.trim(label.text());
            if (text === "Not Circumscribed") {
              nonCircumscribedValue = input.val();
            }
            if (
              $j.inArray(text, [
                "Indistinct",
                "Angular",
                "Micro lobulated",
                "Spiculated",
              ]) !== -1
            ) {
              detailedValues.push(input.val());
              input.add(label).wrapAll('&lt;span class="option-item"&gt;&lt;/span&gt;');
              marginDetails.append(input.parent());
            }
          });
          if (detailedValues.length) {
            margins.first().closest(".row").append(marginDetails);
            var updateMargins = function () {
              var selected = margins.filter(":checked").val();
              marginDetails.toggle(
                selected === nonCircumscribedValue ||
                  $j.inArray(selected, detailedValues) !== -1,
              );
            };
            margins.change(updateMargins);
            updateMargins();
          }
          var descendants = {
            breastLesionPresent: ["intramammaryNode"],
            intramammaryNode: ["vascularityFeature", "lesionMargins"],
            axillaryLesionPresent: ["axillaryFeature"],
            overallAssessment: ["breastAssessment", "axillaryAssessmentType"],
            axillaryAssessmentType: ["axillaryNodeAssessment"],
            axillaryNodeAssessment: ["axillaryDistribution"],
          };
          $j.each(descendants, function (parent, children) {
            getField(parent + ".value").change(function () {
              setTimeout(function () {
                $j.each(children, function (index, child) {
                  getField(child + ".value").change();
                });
              }, 0);
            });
          });
        }, 0);
        report.find("input[type='radio']").change(function () {
          // Preserve the supplied table/textarea helper only for explicit string
          // answers. Coded HFE radios use numeric concept IDs, not these strings.
          var textarea = $j(this).closest("td").find("textarea");
          if (!textarea.length || $j.trim(textarea.val()) !== "") {
            return;
          }
          if ($j(this).val() === "normal") {
            textarea.val("Normal");
          } else if ($j(this).val() === "abnormal") {
            textarea.val("Abnormal because:");
          }
        });
      });
    }
  </script>
