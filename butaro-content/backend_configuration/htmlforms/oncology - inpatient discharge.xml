	<h1>Oncology - Inpatient Discharge Form</h1>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="PATIENT INFORMATION">
		<div class="section-container">
			<table border="2" cellspacing="0" cellpadding="6" width="100%">
				<tr>
					<td>
						<b>IMB ID:</b>
						<lookup class="value" expression="patientIdentifiers.get(&quot;IMB ID&quot;)" />
						<lookup class="value" expression="patientIdentifiers.get(&quot;IMB Primary Care Registration ID&quot;)" />
					</td>
					<td>
						Date:
						<encounterDate id="encounterDate" default="today" />
					</td>
				</tr>
				<tr>
					<td>
						Last name:
						<lookup class="value" expression="patient.personName.familyName" />
					</td>
					<td>
						First name:
						<lookup class="value" expression="patient.personName.givenName" />
					</td>
				</tr>
				<tr>
					<td>
						Clinic:
						<encounterLocation id="encounterLocation" default="Butaro Hospital" />
					</td>
					<td>
						Provider:
						<encounterProvider id="encounterProvider" role="Oncology Provider" />
					</td>
				</tr>
			</table>
		</div>
	</section>

	<section sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="DISCHARGE INFORMATION">
		<div class="section-container">
			<fieldset>
				<legend><b>Visit Details</b></legend>

				<p class="date-one-line">
					<label>Intake Date:</label>
					<obs conceptId="$@Intake_Visit@" allowFutureDates="true" />
				</p>

				<p class="flexView">
					<label>Reason for visit:</label>
					<obs conceptId="$@Reason_for_visit@" />
				</p>

				<p class="flexView">
					<label>Discharge summary:</label>
					<obs conceptId="$@Summary_notes@" cols="60" rows="3" style="textarea" />
				</p>

				<p class="flexView">
					<label>Patient status:</label>
					<obs conceptId="$@Patient_status@" />
				</p>

				<p class="flexView">
					<label>Patient received chemotherapy:</label>
					<obs conceptId="$@Patient_received_chemotherapy@" />
				</p>
			</fieldset>
		</div>
	</section>

