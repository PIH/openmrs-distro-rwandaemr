    <!--
        RWA-1127: on a new database, delete core's default relationship types where nothing uses them, so Initializer
        can create the types relationshipTypes.csv defines. Runs only where such rows exist, and is marked as run otherwise.
    -->
    <changeSet id="RWA-1127-unused-core-relationship-types" author="mseaton">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM relationship_type t
                     WHERE t.uuid IN ('8d919b58-c2cc-11de-8d13-0010c6dffd0f', '8d91a01c-c2cc-11de-8d13-0010c6dffd0f',
                                      '8d91a210-c2cc-11de-8d13-0010c6dffd0f', '8d91a3dc-c2cc-11de-8d13-0010c6dffd0f')
                       AND NOT EXISTS (SELECT 1 FROM relationship r WHERE r.relationship = t.relationship_type_id)
                </sqlCheck>
            </not>
        </preConditions>
        <comment>Delete core's default relationship types where nothing uses them</comment>
        <sqlFile path="sql/RWA-1127-unused-core-relationship-types.sql" relativeToChangelogFile="true" stripComments="true" />
    </changeSet>

</databaseChangeLog>
